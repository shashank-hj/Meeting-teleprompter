<Application
    x:Class="MeetingTeleprompter.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#0D1117" />
                    <SolidColorBrush x:Key="PanelBrush" Color="#161B22" />
                    <SolidColorBrush x:Key="CardBrush" Color="#1C2333" />
                    <SolidColorBrush x:Key="BorderBrush" Color="#30363D" />
                    <SolidColorBrush x:Key="PrimaryBrush" Color="#58A6FF" />
                    <SolidColorBrush x:Key="SuccessBrush" Color="#3FB950" />
                    <SolidColorBrush x:Key="MutedBrush" Color="#8B949E" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
