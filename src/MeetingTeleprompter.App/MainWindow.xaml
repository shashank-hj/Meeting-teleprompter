<Window x:Class="MeetingTeleprompter.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Meeting Teleprompter">
 <Grid x:Name="Root" Background="#F3F5F7" RequestedTheme="Light" SizeChanged="Root_SizeChanged">
  <Grid.Resources>
   <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#216C57"/>
   <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#35866E"/>
   <Style TargetType="Button"><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="14,9"/><Setter Property="FontSize" Value="12"/></Style>
   <Style TargetType="TextBox"><Setter Property="CornerRadius" Value="8"/></Style>
  </Grid.Resources>
  <Grid.ColumnDefinitions><ColumnDefinition x:Name="SourcesColumn" Width="0"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border x:Name="SourcesPane" Visibility="Collapsed" Background="#EAF0EC" BorderBrush="#DCE4DF" BorderThickness="0,0,1,0" Padding="20,28,16,20">
   <Grid RowSpacing="16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Spacing="6">
     <TextBlock Text="KNOWLEDGE LIBRARY" FontSize="10" CharacterSpacing="140" FontWeight="SemiBold" Foreground="#557467"/>
     <TextBlock Text="Your meeting sources" FontSize="19" FontWeight="SemiBold" Foreground="#213D32" TextWrapping="Wrap"/>
     <TextBlock x:Name="SourceCountText" Text="No documents yet" FontSize="12" Foreground="#5F7168" TextWrapping="Wrap"/>
    </StackPanel>
    <StackPanel Grid.Row="1" Spacing="8">
     <Button x:Name="FolderButton" Content="+  Add folder" Click="Folder_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="White"/>
     <Button x:Name="UrlButton" Content="+  Add web page" Click="Url_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="White"/>
    </StackPanel>
    <ListView Grid.Row="2" x:Name="SourceList" SelectionMode="Single" SelectionChanged="SourceSelection_Changed" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
     <ListView.ItemTemplate><DataTemplate><StackPanel Margin="0,8" Spacing="5">
      <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontSize="13" FontWeight="SemiBold" Foreground="#294536"/>
      <TextBlock Text="{Binding Location}" FontSize="10" Foreground="#61756A" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Location}"/>
      <TextBlock Text="{Binding StatusDescription}" FontSize="10" Foreground="#61756A" TextWrapping="Wrap" ToolTipService.ToolTip="{Binding LastError}"/>
     </StackPanel></DataTemplate></ListView.ItemTemplate>
    </ListView>
    <StackPanel Grid.Row="3" Spacing="8">
     <Button x:Name="RefreshButton" Content="Refresh sources" Click="Refresh_Click" HorizontalAlignment="Stretch"/>
     <Button x:Name="RemoveButton" Content="Remove selected" Click="Remove_Click" HorizontalAlignment="Stretch" Background="Transparent" BorderThickness="0" Visibility="Collapsed"/>
     <Border Height="1" Background="#D2DED6" Margin="0,8"/>
     <TextBlock Text="Files stay on this device. Saved web pages refresh only when you ask." FontSize="11" Foreground="#536A5D" TextWrapping="Wrap" LineHeight="17"/>
    </StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Column="1" x:Name="MainWorkspace" Padding="28,24,28,16" RowSpacing="18">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid ColumnSpacing="16">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Grid ColumnSpacing="12" VerticalAlignment="Center">
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border x:Name="BrandMark" Width="40" Height="40" Background="#216C57" CornerRadius="12"><FontIcon Glyph="&#xE8F2;" Foreground="White" FontSize="20"/></Border>
     <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
      <TextBlock x:Name="AppTitle" Text="Meeting Teleprompter" FontSize="24" FontWeight="SemiBold" Foreground="#1E302D" TextTrimming="CharacterEllipsis"/>
      <TextBlock x:Name="AppSubtitle" Text="Your conversation copilot · private, on-device assistance" FontSize="12" Foreground="#62716E" TextTrimming="CharacterEllipsis"/>
     </StackPanel>
    </Grid>
    <StackPanel Grid.Column="1" x:Name="WindowActions" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
     <Button x:Name="SourcesButton" Content="Sources" Click="Sources_Click" ToolTipService.ToolTip="Show your knowledge library"/>
     <Button x:Name="MeetingViewButton" Content="Meeting view" Click="MeetingView_Click" ToolTipService.ToolTip="A compact, always-on-top window beside your call"/>
     <ToggleSwitch x:Name="PinSwitch" OnContent="On top" OffContent="On top" Toggled="Pin_Toggled" MinWidth="88" FontSize="11" ToolTipService.ToolTip="Keep this window above your meeting"/>
     <Button x:Name="HelpButton" Click="Help_Click" AutomationProperties.Name="How it works" ToolTipService.ToolTip="How to use this during a live meeting" Padding="10"><FontIcon Glyph="&#xE897;" FontSize="16"/></Button>
     <Button x:Name="SettingsButton" Click="Settings_Click" AutomationProperties.Name="Settings" ToolTipService.ToolTip="Audio devices, local models and preferences" Padding="10"><FontIcon Glyph="&#xE713;" FontSize="16"/></Button>
    </StackPanel>
   </Grid>
   <Border Grid.Row="1" Background="#193E35" CornerRadius="14" Padding="18,14">
    <Grid x:Name="SessionDock" RowSpacing="12" ColumnSpacing="12">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Spacing="5" VerticalAlignment="Center">
      <StackPanel Orientation="Horizontal" Spacing="8">
       <Ellipse x:Name="SessionDot" Fill="#8AA59B" Width="8" Height="8"/>
       <TextBlock x:Name="SessionLabel" Text="Not listening" FontSize="14" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis"/>
       <TextBlock x:Name="ElapsedText" Text="00:00" FontFamily="Cascadia Mono" FontSize="12" Foreground="#BED9CE" VerticalAlignment="Center"/>
      </StackPanel>
      <TextBlock x:Name="SessionDetailText" Text="Join your call, then start a session here." Foreground="#C3D9D0" FontSize="11" TextWrapping="Wrap"/>
     </StackPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
      <Button x:Name="StopButton" Content="End &amp; clear" Click="StopButton_Click" IsEnabled="False" Visibility="Collapsed" Background="#31594D" Foreground="White" BorderBrush="#618374" ToolTipService.ToolTip="Stop audio and clear the in-memory transcript. Export first to keep a copy."/>
      <Button x:Name="StartButton" Content="Start session" Click="StartButton_Click" Background="#D7F4CF" Foreground="#163E2D" BorderThickness="0" FontWeight="SemiBold"/>
     </StackPanel>
     <StackPanel x:Name="AudioMeterPanel" Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="20" Visibility="Collapsed">
      <StackPanel Width="100" Spacing="5"><TextBlock x:Name="RemoteLevelLabel" Text="Call audio" FontSize="10" Foreground="#C3D9D0"/><ProgressBar x:Name="RemoteLevel" Maximum="100" Height="4" Foreground="#A9DEB5" Background="#3B5E51" AutomationProperties.Name="System audio level"/></StackPanel>
      <StackPanel x:Name="MicMeterPanel" Width="100" Spacing="5"><TextBlock x:Name="MicLevelLabel" Text="Microphone" FontSize="10" Foreground="#C3D9D0"/><ProgressBar x:Name="MicLevel" Maximum="100" Height="4" Foreground="#A9DEB5" Background="#3B5E51" AutomationProperties.Name="Microphone level"/></StackPanel>
      <TextBlock x:Name="TranscriptHealthText" Text="Waiting for speech" FontSize="11" Foreground="#C3D9D0" VerticalAlignment="Center"/>
     </StackPanel>
    </Grid>
   </Border>
   <Grid Grid.Row="2" x:Name="PreparationPanel" ColumnSpacing="12">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="White" BorderBrush="#DFE7E2" BorderThickness="1" CornerRadius="12" Padding="16,12">
     <StackPanel Spacing="6">
      <TextBlock Text="01  BRING YOUR CONTEXT" FontSize="10" CharacterSpacing="75" Foreground="#216C57" FontWeight="SemiBold"/>
      <TextBlock x:Name="SourceReadinessText" Text="Add notes for grounded answers" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="#273D34"/>
      <TextBlock Text="Notes, project documents or web pages." FontSize="11" Foreground="#62716E" TextWrapping="Wrap"/>
      <Button Content="Manage sources" Click="Sources_Click" Background="Transparent" BorderThickness="0" Padding="0,4" Foreground="#216C57"/>
     </StackPanel>
    </Border>
    <Border Grid.Column="1" Background="White" BorderBrush="#DFE7E2" BorderThickness="1" CornerRadius="12" Padding="16,12">
     <StackPanel Spacing="6">
      <TextBlock Text="02  MATCH YOUR AUDIO" FontSize="10" CharacterSpacing="75" Foreground="#216C57" FontWeight="SemiBold"/>
      <TextBlock x:Name="AudioReadinessText" Text="Choose the output used by your call" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="#273D34" MaxLines="2"/>
      <TextBlock x:Name="MicrophoneReadinessText" Text="Your microphone is optional." FontSize="11" Foreground="#62716E" TextWrapping="Wrap"/>
      <Button x:Name="AudioSetupButton" Content="Audio settings" Click="Settings_Click" Background="Transparent" BorderThickness="0" Padding="0,4" Foreground="#216C57"/>
     </StackPanel>
    </Border>
    <Border Grid.Column="2" Background="#EAF2EC" BorderBrush="#D6E5DA" BorderThickness="1" CornerRadius="12" Padding="16,12">
     <StackPanel Spacing="6">
      <TextBlock Text="03  JOIN &amp; LISTEN" FontSize="10" CharacterSpacing="75" Foreground="#216C57" FontWeight="SemiBold"/>
      <TextBlock Text="Meet · Zoom · Teams" FontSize="13" FontWeight="SemiBold" Foreground="#273D34" TextWrapping="Wrap"/>
      <TextBlock Text="Join normally. Start here when you are ready to capture audio." FontSize="11" Foreground="#52695B" TextWrapping="Wrap"/>
      <Button Content="How it works" Click="Help_Click" Background="Transparent" BorderThickness="0" Padding="0,4" Foreground="#216C57"/>
     </StackPanel>
    </Border>
   </Grid>
   <Grid Grid.Row="3" x:Name="ConversationGrid" ColumnSpacing="20">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="TranscriptColumn" Width="320"/></Grid.ColumnDefinitions>
    <Grid RowSpacing="12">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid ColumnSpacing="12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Spacing="3"><TextBlock Text="Meeting assistance" FontSize="18" FontWeight="SemiBold" Foreground="#253B31"/><TextBlock x:Name="AssistanceHintText" Text="Answers with visible evidence, ready when you need them." FontSize="11" Foreground="#65736E" TextWrapping="Wrap"/></StackPanel>
      <ToggleSwitch Grid.Column="1" x:Name="AutomaticSwitch" Header="Auto assist" OnContent="On" OffContent="Paused" IsOn="True" Toggled="Automatic_Toggled" FontSize="11" MinWidth="100" ToolTipService.ToolTip="Pause automatic suggestions without stopping the transcript. Manual questions still work."/>
     </Grid>
     <Grid Grid.Row="1">
      <ScrollViewer x:Name="AnswersScroll" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="SuggestionPanel" Spacing="14" Padding="0,0,4,0"/></ScrollViewer>
      <StackPanel x:Name="AnswerEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="390" Spacing="14" Margin="20">
       <Border x:Name="EmptyMark" Width="52" Height="52" Background="#E3EDE5" CornerRadius="16" HorizontalAlignment="Left"><FontIcon Glyph="&#xE8F2;" FontSize="23" Foreground="#397858"/></Border>
       <TextBlock x:Name="AnswerEmptyTitle" Text="Stay in the conversation." FontSize="27" FontWeight="SemiBold" Foreground="#253F31" TextWrapping="Wrap"/>
       <TextBlock x:Name="AnswerEmptyDescription" Text="Start a session for automatic help, or type a question below. Your sources give every answer more context." TextWrapping="Wrap" Foreground="#61716A" FontSize="14" LineHeight="22"/>
      </StackPanel>
     </Grid>
     <StackPanel Grid.Row="2" Spacing="8">
      <Grid x:Name="CompactAskDock" Visibility="Collapsed" ColumnSpacing="8">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <Button x:Name="CompactAskButton" Content="Ask a question" Click="CompactAsk_Click" HorizontalAlignment="Stretch"/>
       <Button Grid.Column="1" x:Name="LatestDiscussionButton" Content="Answer latest" Click="LatestDiscussion_Click"/>
       <Button Grid.Column="1" x:Name="CompactCancelButton" Content="Cancel answer" Click="Cancel_Click" Visibility="Collapsed"/>
       <Button Grid.Column="2" x:Name="LatestEvidenceButton" Content="Evidence" Click="LatestEvidence_Click"/>
      </Grid>
     <Border x:Name="QuestionComposer" Background="White" BorderBrush="#D5E2D9" BorderThickness="1" CornerRadius="14" Padding="14">
      <StackPanel x:Name="QuestionComposerStack" Spacing="10">
       <TextBox x:Name="SearchBox" AutomationProperties.AutomationId="SearchBox" AutomationProperties.Name="Ask a question" PlaceholderText="Ask quietly, or press Ask for the latest discussion…" BorderThickness="0" Background="Transparent" TextWrapping="Wrap" MaxLength="1500" KeyDown="SearchBox_KeyDown" MinHeight="42" MaxHeight="96"/>
       <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <ComboBox x:Name="AnswerMode" SelectedIndex="0" SelectionChanged="AnswerMode_Changed" MinWidth="120" FontSize="11" BorderThickness="0" Background="#EEF4EE" AutomationProperties.Name="Answer policy"><ComboBoxItem Content="Sources first"/><ComboBoxItem Content="Only my sources"/></ComboBox>
        <Button Grid.Column="1" x:Name="MoreButton" Content="Options" FontSize="12" Padding="10,8"><Button.Flyout><MenuFlyout>
         <MenuFlyoutItem Text="Explain simply" Tag="explain" Click="Route_Click"/>
         <MenuFlyoutItem Text="Check a claim" Tag="check" Click="Route_Click"/>
         <MenuFlyoutItem Text="Suggest a follow-up" Tag="follow-up" Click="Route_Click"/>
         <MenuFlyoutItem Text="Find source evidence" Tag="evidence" Click="Route_Click"/>
        </MenuFlyout></Button.Flyout></Button>
        <Button Grid.Column="2" x:Name="AskButton" Content="Ask →" AutomationProperties.AutomationId="AskButton" Click="Ask_Click" Background="#216C57" Foreground="White" BorderThickness="0" Padding="16,8"/>
       </Grid>
       <Grid><TextBlock x:Name="AnswerHelpText" Text="General background is labeled. Source citations stay visible." FontSize="10" Foreground="#66786C" TextWrapping="Wrap" VerticalAlignment="Center"/><Button x:Name="CancelButton" Content="Cancel answer" Click="Cancel_Click" FontSize="11" Padding="8,4" Background="Transparent" BorderThickness="0" HorizontalAlignment="Right" Visibility="Collapsed"/></Grid>
      </StackPanel>
     </Border>
     </StackPanel>
    </Grid>
    <Border Grid.Column="1" x:Name="TranscriptPane" Background="#EAF0EC" CornerRadius="14" Padding="18">
     <Grid RowSpacing="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel Spacing="5"><TextBlock Text="Live transcript" Foreground="#2B4535" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="TranscriptChannelLabel" Text="Computer audio + microphone" Foreground="#5C7262" FontSize="11"/></StackPanel>
       <Border Grid.Column="1" Background="#DCE8DF" CornerRadius="6" Padding="7,3" VerticalAlignment="Top"><TextBlock Text="ON DEVICE" FontSize="9" Foreground="#44644E" CharacterSpacing="70"/></Border>
      </Grid>
      <TextBlock Grid.Row="1" x:Name="PartialText" Text="" TextWrapping="Wrap" Foreground="#577B62" FontSize="12" MaxHeight="72"/>
      <Grid Grid.Row="2">
       <StackPanel x:Name="TranscriptEmpty" VerticalAlignment="Center" Spacing="12" Margin="8"><FontIcon Glyph="&#xE720;" FontSize="26" Foreground="#82A18D" HorizontalAlignment="Left"/><TextBlock x:Name="TranscriptEmptyTitle" Text="Your conversation appears here." Foreground="#48664F" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="Use the same output device as your call. Headphones help avoid echo." Foreground="#607869" FontSize="12" TextWrapping="Wrap" LineHeight="19"/></StackPanel>
       <ListView x:Name="TranscriptList" SelectionMode="None" Padding="0"><ListView.ItemContainerTransitions><TransitionCollection/></ListView.ItemContainerTransitions><ListView.ItemTemplate><DataTemplate><StackPanel Margin="0,10" Spacing="6"><TextBlock Text="{Binding Header}" FontSize="10" Foreground="#64806B"/><TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="14" Foreground="#2F4A36" IsTextSelectionEnabled="True" LineHeight="22"/></StackPanel></DataTemplate></ListView.ItemTemplate></ListView>
      </Grid>
      <StackPanel Grid.Row="3" Spacing="10"><Border Height="1" Background="#D5E2D9"/><Button x:Name="ExportButton" Content="Export transcript" Click="ExportButton_Click" FontSize="11" Padding="12,6" HorizontalAlignment="Left" Visibility="Collapsed"/><TextBlock Text="End &amp; clear removes this session. Export first to keep the transcript." TextWrapping="Wrap" FontSize="11" Foreground="#5B7162" LineHeight="17"/></StackPanel>
     </Grid>
    </Border>
   </Grid>
   <Grid Grid.Row="4" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <ProgressRing x:Name="BusyIndicator" Width="14" Height="14" IsActive="False" Foreground="#397858"/>
    <TextBlock Grid.Column="1" x:Name="StatusText" Text="Ready · audio capture is off" TextTrimming="CharacterEllipsis" Foreground="#5F7169" FontSize="11" AutomationProperties.LiveSetting="Polite"/>
    <Button Grid.Column="2" x:Name="SessionMenuButton" Content="···" Padding="8,0" Background="Transparent" BorderThickness="0" AutomationProperties.Name="More tools"><Button.Flyout><MenuFlyout>
     <MenuFlyoutItem Text="Export transcript" Click="ExportButton_Click"/>
     <MenuFlyoutItem x:Name="BenchmarkButton" Text="Check device speed" Click="Benchmark_Click"/>
     <MenuFlyoutItem Text="How live meetings work" Click="Help_Click"/>
    </MenuFlyout></Button.Flyout></Button>
   </Grid>
  </Grid>
 </Grid>
</Window>
