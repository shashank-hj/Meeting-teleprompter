<Window x:Class="MeetingTeleprompter.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Meeting Teleprompter">
    <Grid x:Name="Root" Background="#F4F6F3" RequestedTheme="Light" SizeChanged="Root_SizeChanged">
        <Grid.Resources>
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#246B54"/>
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#347D65"/>
            <Style TargetType="Button"><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="14,9"/></Style>
            <Style TargetType="TextBox"><Setter Property="CornerRadius" Value="8"/></Style>
        </Grid.Resources>
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="SourcesColumn" Width="0"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border x:Name="SourcesPane" Visibility="Collapsed" Background="#E9EEE8" BorderBrush="#DCE3DB" BorderThickness="0,0,1,0" Padding="20,28,16,20">
            <Grid RowSpacing="18">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,24">
                    <Border Background="#246B54" CornerRadius="10" Width="36" Height="36"><FontIcon Glyph="&#xE8F2;" FontSize="18" Foreground="White"/></Border>
                    <StackPanel VerticalAlignment="Center"><TextBlock Text="MEETING" FontSize="11" CharacterSpacing="160" Foreground="#506258"/><TextBlock Text="Teleprompter" FontSize="16" FontWeight="SemiBold" Foreground="#1D342A"/></StackPanel>
                </StackPanel>
                <StackPanel Grid.Row="1" Spacing="6"><TextBlock Text="Your sources" FontSize="16" Foreground="#2E4437" FontWeight="SemiBold"/><TextBlock x:Name="SourceCountText" Text="No documents yet" FontSize="12" Foreground="#66766B"/></StackPanel>
                <StackPanel Grid.Row="2" Spacing="8">
                    <Button x:Name="FolderButton" Content="+  Add folder" Click="Folder_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
                    <Button x:Name="UrlButton" Content="+  Add web page" Click="Url_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
                </StackPanel>
                <ListView Grid.Row="3" x:Name="SourceList" SelectionMode="Single" SelectionChanged="SourceSelection_Changed" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemTemplate><DataTemplate>
                        <StackPanel Margin="0,8" Spacing="5"><TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontSize="13" FontWeight="SemiBold" Foreground="#2E4437"/>
                            <TextBlock Text="{Binding Location}" FontSize="10" Foreground="#6B7B70" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Location}"/>
                            <TextBlock Text="{Binding StatusDescription}" FontSize="10" Foreground="#6B7B70" TextWrapping="Wrap" ToolTipService.ToolTip="{Binding LastError}"/></StackPanel>
                    </DataTemplate></ListView.ItemTemplate>
                </ListView>
                <StackPanel Grid.Row="4" Spacing="8">
                    <Button x:Name="RefreshButton" Content="Refresh sources" Click="Refresh_Click" HorizontalAlignment="Stretch"/>
                    <Button x:Name="RemoveButton" Content="Remove selected" Click="Remove_Click" HorizontalAlignment="Stretch" Background="Transparent" BorderThickness="0" Visibility="Collapsed"/>
                    <Border Height="1" Background="#D3DDD2" Margin="0,6"/>
                    <TextBlock Text="Your documents stay on this device." FontSize="11" Foreground="#596B5B" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Column="1" Padding="28,24,28,16" RowSpacing="20">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Spacing="4"><TextBlock Text="Meeting Teleprompter" FontSize="25" FontWeight="SemiBold" Foreground="#20362A" TextTrimming="CharacterEllipsis"/><TextBlock Text="Live help with answers and notes, on your device." FontSize="13" Foreground="#586C5B" TextTrimming="CharacterEllipsis"/></StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button x:Name="SourcesButton" Content="Sources" Click="Sources_Click" ToolTipService.ToolTip="Show or hide your documents"/>
                    <Button Content="Settings" Click="Settings_Click"/>
                    <Button x:Name="BenchmarkButton" Content="Check device" Click="Benchmark_Click" ToolTipService.ToolTip="Check local model speed using a WAV file; microphone stays off"/>
                    <ToggleSwitch x:Name="PinSwitch" OnContent="On top" OffContent="On top" Toggled="Pin_Toggled" MinWidth="90" ToolTipService.ToolTip="Keep this window above the meeting"/>
                </StackPanel>
            </Grid>
            <Border Grid.Row="1" Background="White" BorderBrush="#E1E7DE" BorderThickness="1" CornerRadius="12" Padding="16,12">
                <Grid ColumnSpacing="18">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><Ellipse x:Name="SessionDot" Fill="#A0ACA0" Width="8" Height="8"/><TextBlock x:Name="SessionLabel" Text="Ready when you are" FontSize="13" FontWeight="SemiBold" Foreground="#405242"/></StackPanel>
                    <StackPanel x:Name="AudioMeterPanel" Grid.Column="1" Orientation="Horizontal" Spacing="20" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                        <StackPanel Width="92" Spacing="6"><TextBlock x:Name="RemoteLevelLabel" Text="System audio" FontSize="10" Foreground="#748275"/><ProgressBar x:Name="RemoteLevel" Maximum="100" Value="0" Height="4" Foreground="#438467" AutomationProperties.Name="System audio level"/></StackPanel>
                        <StackPanel x:Name="MicMeterPanel" Width="92" Spacing="6"><TextBlock x:Name="MicLevelLabel" Text="Microphone" FontSize="10" Foreground="#596C5B"/><ProgressBar x:Name="MicLevel" Maximum="100" Value="0" Height="4" Foreground="#438467" AutomationProperties.Name="Microphone level"/></StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                        <Button x:Name="StopButton" Content="Stop listening" Click="StopButton_Click" IsEnabled="False" Visibility="Collapsed"/>
                        <Button x:Name="StartButton" Content="Start session" Click="StartButton_Click" Background="#246B54" Foreground="White" BorderThickness="0"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Row="2" ColumnSpacing="20">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="TranscriptColumn" Width="310"/></Grid.ColumnDefinitions>
                <Grid RowSpacing="16">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="Answers" FontSize="17" FontWeight="SemiBold" Foreground="#233B2D"/>
                    <Grid Grid.Row="1">
                        <ScrollViewer x:Name="AnswersScroll" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="SuggestionPanel" Spacing="14" Padding="0,0,4,0"/></ScrollViewer>
                        <StackPanel x:Name="AnswerEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="390" Spacing="14" Margin="18">
                            <Border Width="56" Height="56" Background="#E4ECE1" CornerRadius="18" HorizontalAlignment="Left"><FontIcon Glyph="&#xE8F2;" FontSize="24" Foreground="#477452"/></Border>
                            <TextBlock Text="A clear answer, when you need one." FontSize="24" FontWeight="SemiBold" Foreground="#294132" TextWrapping="Wrap"/>
                            <TextBlock Text="Ask below, or start listening for answers during a meeting. You can ask without starting a session." TextWrapping="Wrap" Foreground="#596C5B" FontSize="14" LineHeight="22"/>
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="2" Background="White" BorderBrush="#D4DED1" BorderThickness="1" CornerRadius="14" Padding="14">
                        <StackPanel Spacing="12">
                            <TextBox x:Name="SearchBox" AutomationProperties.AutomationId="SearchBox" PlaceholderText="Ask a question…" BorderThickness="0" Background="Transparent" TextWrapping="Wrap" MaxLength="1500" KeyDown="SearchBox_KeyDown" MinHeight="48" MaxHeight="110"/>
                            <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <ComboBox x:Name="AnswerMode" SelectedIndex="0" SelectionChanged="AnswerMode_Changed" MinWidth="135" FontSize="11" BorderThickness="0" Background="#F1F5EE" AutomationProperties.Name="Answer policy" ToolTipService.ToolTip="Use sources first; allow clearly labeled general answers when they do not cover a question"><ComboBoxItem Content="Sources first"/><ComboBoxItem Content="Only my sources"/></ComboBox>
                                <Button Grid.Column="1" x:Name="MoreButton" Content="More options" FontSize="12" Padding="10,8">
                                    <Button.Flyout><MenuFlyout>
                                        <MenuFlyoutItem Text="Explain simply" Tag="explain" Click="Route_Click"/>
                                        <MenuFlyoutItem Text="Check a claim against sources" Tag="check" Click="Route_Click"/>
                                        <MenuFlyoutItem Text="Suggest a follow-up" Tag="follow-up" Click="Route_Click"/>
                                        <MenuFlyoutItem Text="Show source passages" Tag="evidence" Click="Route_Click"/>
                                    </MenuFlyout></Button.Flyout>
                                </Button>
                                <Button Grid.Column="2" x:Name="AskButton" Content="Ask  →" Click="Ask_Click" Background="#246B54" Foreground="White" BorderThickness="0" Padding="16,8"/>
                            </Grid>
                            <Grid><TextBlock x:Name="AnswerHelpText" Text="If your sources don't cover it, general answers are clearly labeled." FontSize="11" Foreground="#6C7D6C" TextWrapping="Wrap" VerticalAlignment="Center"/><Button x:Name="CancelButton" Content="Cancel answer" Click="Cancel_Click" FontSize="11" Padding="8,4" Background="Transparent" BorderThickness="0" HorizontalAlignment="Right" Visibility="Collapsed"/></Grid>
                        </StackPanel>
                    </Border>
                </Grid>
                <Border Grid.Column="1" Background="#ECF0E9" CornerRadius="14" Padding="18">
                    <Grid RowSpacing="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel Spacing="5"><TextBlock Text="Live transcript" Foreground="#334936" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="TranscriptChannelLabel" Text="System audio + microphone" Foreground="#596C5B" FontSize="11"/></StackPanel>
                        <TextBlock Grid.Row="1" x:Name="PartialText" Text="" TextWrapping="Wrap" Foreground="#648567" FontSize="12" MaxHeight="80"/>
                        <Grid Grid.Row="2">
                            <StackPanel x:Name="TranscriptEmpty" VerticalAlignment="Center" Spacing="12" Margin="8"><FontIcon Glyph="&#xE720;" FontSize="26" Foreground="#8BA484" HorizontalAlignment="Left"/><TextBlock x:Name="TranscriptEmptyTitle" Text="Start listening to see the conversation." Foreground="#4D684F" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="Use headphones to avoid recording the meeting twice." Foreground="#637963" FontSize="12" TextWrapping="Wrap" LineHeight="19"/></StackPanel>
                            <ListView x:Name="TranscriptList" SelectionMode="None" Padding="0"><ListView.ItemTemplate><DataTemplate><StackPanel Margin="0,10" Spacing="6"><TextBlock Text="{Binding Header}" FontSize="10" Foreground="#72856C"/><TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="14" Foreground="#344631" IsTextSelectionEnabled="True" LineHeight="22"/></StackPanel></DataTemplate></ListView.ItemTemplate></ListView>
                        </Grid>
                        <StackPanel Grid.Row="3" Spacing="10"><Border Height="1" Background="#DCE4D7"/><Button x:Name="ExportButton" Content="Export transcript" Click="ExportButton_Click" FontSize="11" Padding="12,6" HorizontalAlignment="Left" Visibility="Collapsed"/><TextBlock Text="The transcript clears when the session ends." TextWrapping="Wrap" FontSize="11" Foreground="#5D705B"/></StackPanel>
                    </Grid>
                </Border>
            </Grid>
            <Grid Grid.Row="3" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <ProgressRing x:Name="BusyIndicator" Width="14" Height="14" IsActive="False" Foreground="#3D7450"/>
                <TextBlock Grid.Column="1" x:Name="StatusText" Text="Ready · local and private" TextTrimming="CharacterEllipsis" Foreground="#657661" FontSize="11" AutomationProperties.LiveSetting="Polite"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
